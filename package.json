{
  "name": "sz-labs-inventory-test",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "node --env-file-if-exists=.env.local scripts/dev-api.mjs",
    "build": "npm run build --workspace frontend",
    "test": "node --test tests/*.test.mjs && npm test --workspace frontend",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "mysql2": "3.24.6",
    "yaml": "2.9.1",
    "decimal.js": "10.6.0"
  }
}
