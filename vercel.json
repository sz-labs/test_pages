{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/inventory.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/inventory?route=:route*"
    }
  ]
}
